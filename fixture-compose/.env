# Beside the file that needs it, which is how the workflow stages it: the compose job
# copies the whole directory, and upload-artifact is told to include hidden files.
#
# IMAGE_PREFIX and IMAGE_TAG are declared here because the compose job requires every
# unguarded name to be - a `:-` default leaves the variable not Required, and the gate
# then looks for it in this file.
IMAGE_PREFIX=unset-image-prefix
IMAGE_TAG=unset-image-tag
